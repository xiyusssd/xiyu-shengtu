{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xiyu-shengtu",
  "version": "0.2.0",
  "identifier": "com.xiyu.shengtu",
  "build": {
    "beforeDevCommand": "node_modules/.bin/vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node_modules/.bin/tsc -b && node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xiyu-shengtu",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xiyusssd/xiyu-shengtu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RTA0QkREODIzRjlBRTkKUldUcG1qK0MzVXZncURGZ1UvR1BVV0lGSGQvb1kyejVMbVUxS2FWRTMyVG53dExGMVFLemM3NEEK"
    }
  }
}
